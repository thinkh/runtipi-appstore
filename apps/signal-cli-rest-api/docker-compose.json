{
  "schemaVersion": 2,
  "services": [
    {
      "name": "signal-cli-rest-api",
      "image": "bbernhard/signal-cli-rest-api:0.98",
      "isMain": true,
      "internalPort": 8080,
      "environment": [
        {
          "key": "MODE",
          "value": "native"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/signal-cli",
          "containerPath": "/home/.local/share/signal-cli"
        }
      ]
    }
  ]
}
